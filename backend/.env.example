# ══════════════════════════════════════════════════════════════
#  Flexy – Environment Variables (.env.example)
#  1. Copy:  cp .env.example .env
#  2. Fill in your real values in .env
#  3. NEVER commit .env to git
# ══════════════════════════════════════════════════════════════

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace-this-with-a-64-char-random-string
# Generate: python -c "import secrets; print(secrets.token_hex(32))"

# ── Supabase ──────────────────────────────────────────────────
# Get from: supabase.com → Your Project → Settings → API
# Use the SERVICE ROLE key (not anon key) for backend
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ── Email (SMTP / Gmail) ──────────────────────────────────────
# Gmail setup:
#   1. Enable 2-Step Verification at myaccount.google.com
#   2. Go to: myaccount.google.com → Security → App Passwords
#   3. Generate an App Password for "Mail" (name it "Flexy")
#   4. Use the 16-char password below (NOT your Gmail password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Razorpay (optional) ───────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
# Leave blank to run in sandbox mode (no real payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5000
PORT=5000
